PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Local: an AWS CLI profile. Hosted: set AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY instead.
AWS_PROFILE=
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
# Stops model calls after this many per server run. The fixed template takes over. Default 100.
BEDROCK_MAX_CALLS=
# Runs with recorded PayPal and AI replies, and no keys. Also the default when PayPal keys are missing.
SAMPLE_MODE=
# Where PayPal sends the buyer back to. Defaults to the host's URL, or localhost.
PUBLIC_URL=
# From registering the webhook at PayPal. Webhooks are refused without it.
PAYPAL_WEBHOOK_ID=
