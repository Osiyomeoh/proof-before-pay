{
  "name": "proof-before-pay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.ts",
    "sample": "SAMPLE_MODE=1 node --disable-warning=ExperimentalWarning src/main.ts",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "eval": "node --disable-warning=ExperimentalWarning scripts/eval-verdict.ts",
    "sandbox": "node --disable-warning=ExperimentalWarning scripts/sandbox-run.ts",
    "explain": "node --disable-warning=ExperimentalWarning scripts/explain-run.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^1.1.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0"
  }
}
